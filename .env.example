# Copy to .env and fill in. Never commit a real .env.

# Gnani API key - one key covers STT + TTS. Get it at app.gnani.ai/voice
GNANI_API_KEY=

# Path to the extracted capstone dataset folder
# (Capstone_Project_Dataset_FTTT_2026 - contains kb/, data/, practice/, tools/)
VOICEOPS_DATA_DIR=

# Optional: an OpenAI-compatible LLM key, only if you want the Step 1
# baseline / answer phrasing to call a hosted LLM. The agent works
# fully without it.
LLM_API_KEY=
